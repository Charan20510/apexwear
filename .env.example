# ./run_dev.sh generates a real .env from this file on first run — it fills in a
# freshly generated secret key and a DATABASE_URL using the current machine's
# postgres user, so you normally never edit this by hand.
DJANGO_SECRET_KEY=change-me
DEBUG=True
# Hosts Django will answer for. Defaults to localhost,127.0.0.1 when unset — which
# means an ngrok/tunnel request is rejected with 400 *before any view runs*. If you
# are testing Razorpay webhooks you MUST add your tunnel host here or every webhook
# silently fails. A leading dot matches all subdomains, so this survives ngrok
# handing you a new URL on each restart:
#   ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Replace <youruser> with your postgres role (run_dev.sh uses $USER).
DATABASE_URL=postgres://<youruser>@localhost:5432/apexwear
SEARCH_RO_PASSWORD=search_ro

# Google Sign-In. Create an OAuth 2.0 Client ID (type: Web application) at
# console.cloud.google.com, with http://localhost:5173 as an authorised JavaScript
# origin. Leave blank to disable Google sign-in — /api/auth/google then returns 503
# and the button is hidden in the UI.
GOOGLE_OAUTH_CLIENT_ID=

# Razorpay (Phase 3). Leave ALL THREE blank to disable online payment — checkout
# with payment_method=cod still works, and payment_method=razorpay returns a clear
# "not configured" 503 instead of building a broken order. Setting only some of
# them is the one bad state; `manage.py check` warns about it.
#
# KEY_ID / KEY_SECRET: Dashboard (Test Mode) > Settings > API Keys > Generate Test
# Key. The secret is shown exactly once — copy both halves from the same popup, or
# they won't match. Verify the pair before trusting the app; this must not 401:
#   curl -u "$RAZORPAY_KEY_ID:$RAZORPAY_KEY_SECRET" https://api.razorpay.com/v1/orders
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# WEBHOOK_SECRET: a random string YOU choose and type into the "Secret" box at
# Dashboard > Settings > Webhooks. It is NOT the webhook URL and NOT the API key.
# Pasting the endpoint URL here is a real mistake that has happened on this project:
# every webhook then fails signature verification, so payments succeed in the
# browser while orders sit PENDING forever. `manage.py check` warns about a URL
# here (orders.W003), and checkout refuses the razorpay path with a 503 rather
# than charging a card whose payment could never be confirmed.
#
# The webhook endpoint itself is:  https://<your-tunnel-host>/api/payments/webhook/
# (trailing slash required), subscribed to exactly: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=
